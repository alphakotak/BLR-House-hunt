# Copy to .env for local runs (never commit .env). On GitHub these are secrets.

# --- Email (Gmail example) ---
# For Gmail, create an App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youremail@gmail.com
SMTP_PASS=your_16_char_app_password
EMAIL_FROM=youremail@gmail.com
EMAIL_TO=youremail@gmail.com

# --- Facebook session ---
# Local: point to the file created by scripts/save_session.py
FB_STORAGE_STATE_PATH=data/fb_state.json
# Set HEADLESS=0 to watch the browser while debugging locally.
HEADLESS=1

# --- Testing without Facebook ---
# POSTS_FIXTURE=tests/fixtures/sample_posts.json
